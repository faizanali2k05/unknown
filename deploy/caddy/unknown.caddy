# =============================================================================
#  UNKNOWN — Reverse proxy vhost snippet (ADD to the existing proxy; never
#  replace it, never touch n8n's existing vhosts).
# -----------------------------------------------------------------------------
#  This is a SEPARATE block for Unknown's subdomains only. Adding it to the
#  live proxy config is a "Confirm-before" action — present this exact diff and
#  wait for the OK before applying.
#
#  Existing host already serves:  n8n.seemaai.co.uk  /  app.seemaai.co.uk
#  Unknown adds NEW vhosts only — it does not modify those.
#
#  If the live proxy is Caddy, append these blocks. If it's Nginx / NPM /
#  Traefik, translate the same intent: route the subdomain -> 127.0.0.1:API_HOST_PORT
#  with WebSocket upgrade passthrough.
# =============================================================================

# --- API (REST + WebSocket). WS upgrade is automatic in Caddy. ---------------
api.seemaai.co.uk {
	encode zstd gzip

	# Forward to the API bound on loopback by docker-compose.
	reverse_proxy 127.0.0.1:8090 {
		# Preserve client IP for rate limiting / logs.
		header_up X-Real-IP {remote_host}
	}
}

# --- LiveKit signaling (Phase 4). Host-networked on :7880. -------------------
livekit.seemaai.co.uk {
	encode zstd gzip
	reverse_proxy 127.0.0.1:7880
}

# --- MinIO media (signed voicemail URLs the phone fetches). ------------------
# Routes to the internal MinIO. If you prefer to keep MinIO fully private,
# drop this block and stream voicemail through the API instead.
media.seemaai.co.uk {
	encode gzip
	reverse_proxy 127.0.0.1:9000
}

# -----------------------------------------------------------------------------

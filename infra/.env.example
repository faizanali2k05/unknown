# =============================================================================
#  Unknown — infra environment. Copy to `.env` and fill in real values.
#      cp .env.example .env && bash ../scripts/gen-secrets.sh
#  `.env` is gitignored and must never be committed.
# =============================================================================

# ---- Domain ----------------------------------------------------------------
API_DOMAIN=api.seemaai.co.uk
RTC_DOMAIN=rtc.seemaai.co.uk
TURN_DOMAIN=turn.seemaai.co.uk

# ---- API publishing --------------------------------------------------------
# Docker bridge gateway, NOT 0.0.0.0. This is what the containerised Caddy
# reaches; it is not routable from the internet.
API_BIND_ADDR=172.17.0.1
API_HOST_PORT=8100
# Port the Nest process listens on inside its container.
API_PORT=3000

# ---- PostgreSQL (never published) ------------------------------------------
POSTGRES_USER=unknown
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=unknown
DATABASE_URL=postgresql://unknown:__CHANGE_ME__@unknown-postgres:5432/unknown?schema=public

# ---- Redis (never published) -----------------------------------------------
REDIS_URL=redis://unknown-redis:6379

# ---- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=__CHANGE_ME_64_HEX__
JWT_REFRESH_SECRET=__CHANGE_ME_64_HEX__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=*
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- Push (Phase 6) --------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ---- Media storage: self-hosted MinIO --------------------------------------
# Internal address the API talks to (container name on unknown-net).
S3_ENDPOINT=http://unknown-minio:9000
# Public address the phone fetches presigned URLs from (via Caddy).
S3_PUBLIC_ENDPOINT=https://media.seemaai.co.uk
S3_REGION=us-east-1
S3_BUCKET=unknown-media
S3_ACCESS_KEY_ID=unknown
S3_SECRET_ACCESS_KEY=__CHANGE_ME__
S3_FORCE_PATH_STYLE=true
# MinIO's S3 port on the host (bridge gateway only, never 0.0.0.0).
MINIO_BIND_ADDR=172.17.0.1
MINIO_HOST_PORT=9100

# ---- LiveKit (Phase 7) -----------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://rtc.seemaai.co.uk
TURN_STATIC_AUTH_SECRET=

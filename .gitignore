# ---------- Secrets — never commit ----------
.env
.env.*
!.env.example
secrets/
*.pem
*.p8
*.p12
*.jks
*.keystore
# Firebase Android config. It ships inside the APK, so it is not a server
# secret — but it carries an API key that GitHub's scanner flags, so it stays
# out of the repo. EAS gets it from the GOOGLE_SERVICES_JSON file secret
# instead (see apps/mobile/app.config.js).
google-services.json
GoogleService-Info.plist


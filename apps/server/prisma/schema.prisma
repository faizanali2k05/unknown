// =============================================================================
//  Unknown — private messaging, calling, contacts, and meeting app.
//  Mirrors the SQL in CLAUDE.md. Two rules that drive the design:
//    1. messages.clientId is generated ON THE DEVICE before send. It powers the
//       offline queue, duplicate prevention and the sending→sent→delivered→read
//       pipeline. The server is never the source of a message's identity.
//    2. Read state lives in conversationMembers.lastReadAt — never a row per
//       message per user.
//  User UUIDs remain internal; KASSI public IDs are the only way to find
//  another account, and there is no public user directory.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  direct
  group
}

enum MemberRole {
  member
  admin
}

enum MessageType {
  text
  image
  voice
  file
  system
}

enum CallKind {
  audio
  video
}

enum CallStatus {
  ringing
  answered
  rejected
  missed
  ended
  failed
}

enum MeetingStatus {
  active
  ended
  expired
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
  cancelled
}

// -----------------------------------------------------------------------------
//  User
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid()) @db.Uuid
  publicId     String    @unique @map("public_id") @db.VarChar(16)
  username     String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  statusText   String?   @map("status_text")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  memberships            ConversationMember[]
  messages               Message[]            @relation("MessageSender")
  conversations          Conversation[]       @relation("ConversationCreator")
  callsInitiated         Call[]               @relation("CallInitiator")
  meetingsCreated        Meeting[]            @relation("MeetingCreator")
  devices                Device[]
  refreshTokens          RefreshToken[]
  sentFriendRequests     FriendRequest[]      @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]      @relation("FriendRequestReceiver")
  blocksSent             UserBlock[]          @relation("UserBlocker")
  blocksReceived         UserBlock[]          @relation("UserBlocked")
  friendshipsLow         Friendship[]         @relation("FriendshipLow")
  friendshipsHigh        Friendship[]         @relation("FriendshipHigh")

  @@map("users")
}

model FriendRequest {
  id         String              @id @default(uuid()) @db.Uuid
  senderId   String              @map("sender_id") @db.Uuid
  receiverId String              @map("receiver_id") @db.Uuid
  status     FriendRequestStatus @default(pending)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  sender   User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
  @@map("friend_requests")
}

model Friendship {
  userLowId  String   @map("user_low_id") @db.Uuid
  userHighId String   @map("user_high_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  userLow  User @relation("FriendshipLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@id([userLowId, userHighId])
  @@index([userHighId])
  @@map("friendships")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// -----------------------------------------------------------------------------
//  Auth support
// -----------------------------------------------------------------------------

/// Rotating refresh tokens, stored hashed so a DB leak cannot be replayed.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
//  Conversations
// -----------------------------------------------------------------------------
model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  title     String?
  avatarUrl String?          @map("avatar_url")
  createdBy String?          @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  creator  User?                @relation("ConversationCreator", fields: [createdBy], references: [id])
  members  ConversationMember[]
  messages Message[]
  calls    Call[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String     @map("conversation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(member)
  /// Single source of read state — unread count is derived from this.
  lastReadAt     DateTime?  @map("last_read_at") @db.Timestamptz
  joinedAt       DateTime   @default(now()) @map("joined_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

// -----------------------------------------------------------------------------
//  Messages
// -----------------------------------------------------------------------------
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  /// Generated on the device before send. Makes retries idempotent.
  clientId       String      @map("client_id") @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String?     @map("sender_id") @db.Uuid
  type           MessageType @default(text)
  body           String?
  mediaUrl       String?     @map("media_url")
  mediaMeta      Json?       @map("media_meta")
  replyToId      String?     @map("reply_to_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz
  /// Soft delete — "delete for everyone" sets this, the row stays.
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReplies")

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

// -----------------------------------------------------------------------------
//  Calls — every call is relayed through LiveKit (team of <50, no P2P).
// -----------------------------------------------------------------------------
model Call {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @map("conversation_id") @db.Uuid
  initiatorId    String?    @map("initiator_id") @db.Uuid
  kind           CallKind
  status         CallStatus @default(ringing)
  /// Random UUID — never derived from conversation or user ids.
  roomName       String     @map("room_name")
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz
  answeredAt     DateTime?  @map("answered_at") @db.Timestamptz
  endedAt        DateTime?  @map("ended_at") @db.Timestamptz
  endReason      String?    @map("end_reason")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  initiator    User?        @relation("CallInitiator", fields: [initiatorId], references: [id])

  @@index([conversationId, startedAt(sort: Desc)])
  @@map("calls")
}

model Meeting {
  id          String        @id @default(uuid()) @db.Uuid
  meetingCode String        @unique @map("meeting_code") @db.VarChar(24)
  roomName    String        @unique @map("room_name")
  createdById String        @map("created_by_id") @db.Uuid
  status      MeetingStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz
  endedAt     DateTime?     @map("ended_at") @db.Timestamptz

  createdBy User @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("meetings")
}

// -----------------------------------------------------------------------------
//  Devices — FCM push targets (Android only).
// -----------------------------------------------------------------------------
model Device {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fcmToken  String   @unique @map("fcm_token")
  platform  String   @default("android")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

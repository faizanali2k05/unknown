# Local dev convenience for the API only. The real source of truth is the
# repo-root .env consumed by docker-compose. For running the API outside
# Docker, point these at localhost-exposed services.
DATABASE_URL=postgresql://unknown:unknown@localhost:5432/unknown?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3000
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=unknown-voicemail
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=unknown
MINIO_ROOT_PASSWORD=unknown
LIVEKIT_API_KEY=unknown_dev_key
LIVEKIT_API_SECRET=dev_livekit_secret_change_me
LIVEKIT_URL=ws://localhost:7880
CORS_ORIGINS=*
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
NODE_ENV=development
LOG_LEVEL=debug

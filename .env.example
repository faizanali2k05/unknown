# =============================================================================
#  UNKNOWN — Environment Configuration
# -----------------------------------------------------------------------------
#  Copy to `.env` and fill real secrets:   cp .env.example .env
#  Generate strong secrets:                bash scripts/gen-secrets.sh
#
#  RULE: Every value here is overridable. Internal services (postgres/redis/
#  minio) NEVER bind a host port — they talk only over `unknown_net`. Only the
#  values under "HOST-EXPOSED PORTS" map to the host, and each one must be
#  verified free on the live VPS before use (scripts/preflight.sh).
# =============================================================================

# ---------- Project / Docker namespace (do not change casually) --------------
COMPOSE_PROJECT_NAME=unknown
NETWORK_NAME=unknown_net

# ---------- Deployment domain (Caddy/proxy vhost) ----------------------------
# These subdomains must NOT collide with n8n.seemaai.co.uk / app.seemaai.co.uk
API_DOMAIN=api.seemaai.co.uk
LIVEKIT_DOMAIN=livekit.seemaai.co.uk
TURN_DOMAIN=turn.seemaai.co.uk

# =============================================================================
#  HOST-EXPOSED PORTS  — verify each is free on the VPS (scripts/preflight.sh)
# =============================================================================
# API HTTP. Only published to host if NO reverse proxy fronts it. When the
# existing proxy routes API_DOMAIN -> this port, keep it bound to 127.0.0.1.
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8090
# Port the NestJS process listens on INSIDE its container.
API_PORT=3000

# LiveKit (Phase 4 — host networking). Confirmed-free high ports only.
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
# UDP media range for LiveKit (small for MVP; open in firewall = confirm-before)
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50100

# coturn (Phase 4 — host networking)
TURN_LISTENING_PORT=3478
TURN_MIN_PORT=50200
TURN_MAX_PORT=50300

# =============================================================================
#  INTERNAL SERVICES  (no host ports — reached only via unknown_net DNS names)
# =============================================================================
# ---------- PostgreSQL ----------
POSTGRES_USER=unknown
POSTGRES_PASSWORD=__CHANGE_ME_STRONG__
POSTGRES_DB=unknown
# Host = the compose service name on unknown_net. Port stays internal (5432).
DATABASE_URL=postgresql://unknown:__CHANGE_ME_STRONG__@unknown_postgres:5432/unknown?schema=public

# ---------- Redis ----------
REDIS_URL=redis://unknown_redis:6379

# ---------- MinIO (S3-compatible voicemail/media store) ----------
MINIO_ROOT_USER=unknown
MINIO_ROOT_PASSWORD=__CHANGE_ME_STRONG__
S3_ENDPOINT=http://unknown_minio:9000
# Public endpoint used to build signed URLs the phone can reach (via proxy).
S3_PUBLIC_ENDPOINT=https://media.seemaai.co.uk
S3_REGION=us-east-1
S3_BUCKET=unknown-voicemail
S3_FORCE_PATH_STYLE=true

# =============================================================================
#  APPLICATION SECRETS  (generate with scripts/gen-secrets.sh — never reuse)
# =============================================================================
JWT_ACCESS_SECRET=__CHANGE_ME_64_HEX__
JWT_REFRESH_SECRET=__CHANGE_ME_64_HEX__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- LiveKit (Phase 4) ----------
LIVEKIT_API_KEY=unknown_dev_key
LIVEKIT_API_SECRET=__CHANGE_ME_64_HEX__
LIVEKIT_URL=wss://livekit.seemaai.co.uk

# ---------- coturn shared secret (Phase 4) ----------
TURN_STATIC_AUTH_SECRET=__CHANGE_ME_64_HEX__

# =============================================================================
#  PUSH NOTIFICATIONS  (Phase 4 — leave blank for MVP)
# =============================================================================
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=co.uk.seemaai.unknown

# =============================================================================
#  RUNTIME
# =============================================================================
NODE_ENV=production
# Comma-separated allowed origins for CORS (mobile uses native, * is fine for API)
CORS_ORIGINS=*
# Rate limit (requests / window-seconds) on auth + messaging
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOG_LEVEL=info
